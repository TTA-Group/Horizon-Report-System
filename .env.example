# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (ห้าม commit ไฟล์ .env)
# อ้างอิงหัวข้อ 8 ในไฟล์ spec.md

# LINE Messaging API (Bot)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LINE Login channel (ใช้ตรวจสอบ ID token ฝั่ง server)
LINE_LOGIN_CHANNEL_ID=

# LIFF
LIFF_ID=

# ฐานข้อมูล PostgreSQL (แนะนำใช้ connection string แบบ pooler ของ Supabase)
DATABASE_URL=

# ที่เก็บไฟล์แนบ (Supabase Storage หรือเทียบเท่า)
# bucket นี้ต้องเป็น public เพราะภาพต้องแสดงในแอปได้
STORAGE_BUCKET_URL=
STORAGE_SERVICE_KEY=

# ที่เก็บไฟล์สำรองข้อมูล — ต้องเป็น bucket แบบ private และแยกคนละตัวกับ STORAGE_BUCKET_URL
# เพราะไฟล์สำรองมีข้อมูลส่วนบุคคลของพนักงานทุกคน (ถ้าไม่ตั้งค่า ระบบจะไม่เขียนไฟล์สำรองเลย)
BACKUP_BUCKET_URL=

# รหัสพนักงานที่มีสิทธิ์ผู้ดูแลระบบ (HR) คั่นด้วยจุลภาค เช่น 10001,10002
ADMIN_EMPLOYEE_CODES=

# โดเมนอีเมลของบริษัท เช่น thoresen.com (มีหลายโดเมนให้คั่นด้วยจุลภาค)
# ใช้กรองตอนผู้ที่ไม่มีรหัสพนักงานในระบบกรอกข้อมูลเอง — ต้องใช้อีเมลในโดเมนนี้เท่านั้น
# เว้นว่างไว้ = ไม่ตรวจสอบโดเมน (อีเมลจะไม่ใช่ช่องบังคับ)
COMPANY_EMAIL_DOMAIN=

# ป้องกันการเรียก endpoint งานตามเวลาจากภายนอก
CRON_SECRET=

# ที่อยู่สาธารณะของระบบ (เช่น https://report.example.com)
# ใช้ประกอบลิงก์รายงานสรุปในข้อความที่ส่งตามเวลาเท่านั้น — เว้นว่างได้
PUBLIC_BASE_URL=

# กรณีใช้ OA ร่วมกับระบบอื่น (เช่น ระบบจองนวด)
# ใส่ที่อยู่ webhook ของระบบเดิม ระบบนี้จะส่งต่อ event ต้นฉบับไปให้ ระบบเดิมจึงทำงานต่อได้ตามปกติ
# เว้นว่างไว้ได้ถ้าไม่ได้ใช้ OA ร่วมกับระบบอื่น
MASSAGE_WEBHOOK_URL=
