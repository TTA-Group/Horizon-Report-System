# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (ห้าม commit ไฟล์ .env)
# อ้างอิงหัวข้อ 8 ในไฟล์ spec.md

# LINE Messaging API (Bot)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LINE Login channel (ใช้ตรวจสอบ ID token ฝั่ง server)
LINE_LOGIN_CHANNEL_ID=

# LIFF
LIFF_ID=

# ฐานข้อมูล PostgreSQL (แนะนำใช้ connection string แบบ pooler ของ Supabase)
DATABASE_URL=

# ที่เก็บไฟล์แนบ (Supabase Storage หรือเทียบเท่า)
STORAGE_BUCKET_URL=
STORAGE_SERVICE_KEY=

# รหัสพนักงานที่มีสิทธิ์ผู้ดูแลระบบ (HR) คั่นด้วยจุลภาค เช่น HR001,HR002
ADMIN_EMPLOYEE_CODES=

# ป้องกันการเรียก endpoint งานตามเวลาจากภายนอก
CRON_SECRET=

# กรณีใช้ OA ร่วมกับระบบอื่น (เช่น ระบบจองนวด)
# ใส่ที่อยู่ webhook ของระบบเดิม ระบบนี้จะส่งต่อ event ต้นฉบับไปให้ ระบบเดิมจึงทำงานต่อได้ตามปกติ
# เว้นว่างไว้ได้ถ้าไม่ได้ใช้ OA ร่วมกับระบบอื่น
MASSAGE_WEBHOOK_URL=
